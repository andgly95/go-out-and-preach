[gd_resource type="Resource" script_class="Activity" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/entities/activity.gd" id="1_activity"]

[resource]
script = ExtResource("1_activity")
id = &"coworker_invite"
title = "Say yes to {coworker}"
description = "{coworker} from work keeps inviting you out. You keep saying no."
icon = "✉"
days = Array[int]([1, 5])
order = 60
energy_cost = 2
conviction = -1
exposure = 3.0
result_text = "A crowded bar with the music too loud. You drink a soda and laugh at the right places, and nobody asks you anything you have to answer."
requires_flag = "dana_asked"
